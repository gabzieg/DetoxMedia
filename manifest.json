{
  "manifest_version": 3,
  "name": "Social Media Blocker",
  "version": "1.0",
  "description": "A simple distraction blocker to keep you focused.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["bloqueio.js"],
      "css": ["estilo.css"],
      "run_at": "document_start"
    }
  ]
}