{
  "manifest_version": 3,
  "name": "DetoxMedia",
  "version": "1.0",
  "description": "A simple distraction blocker to keep you focused.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Focus Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["bloqueio.js"],
      "css": ["estilo.css"],
      "run_at": "document_start"
    }
  ]
}